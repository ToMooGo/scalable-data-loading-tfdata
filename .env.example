# Copy to .env to override the defaults used by docker-compose.yml
# use URL-safe characters (no @ : / #) in the password: it is embedded in connection URLs.
# The password is stored in the pgdata volume on first start: after changing it, run
# `docker compose down -v` (this deletes the local databases).
POSTGRES_USER=mlops
POSTGRES_PASSWORD=mlops
POSTGRES_PORT=5433
MLFLOW_PORT=5050
PREFECT_PORT=4200
API_PORT=8000
# keep 1 (POST /reload reaches a single worker); scale with replicas instead
API_WORKERS=1
# configs/quick_flow_config.yaml runs in a few minutes instead of about 45 minutes
FLOW_CONFIG=configs/full_flow_config.yaml
# auto = tfds.load as in the book, falling back to the checksum-verified mirror; or tfds | mirror
MNIST_SOURCE=auto
# bind address for published ports (127.0.0.1 = this machine only)
BIND_ADDR=127.0.0.1
# protects POST /reload when set (the pipeline sends it automatically)
ADMIN_TOKEN=
# Linux: run the pipeline as your user so files in ./reports are yours (see `id -u` / `id -g`)
HOST_UID=1000
HOST_GID=1000
MONITOR_CRON="0 * * * *"
